# ============================================
# PLANTILLA PARA PRODUCCIÓN (VPS + Caddy)
# Copiar a .env en el servidor y poner secretos FUERTES.
# Genera cada secreto con:  openssl rand -hex 48
# ============================================

# --- Dominio público (el "único link") ---
DOMAIN=legal-ai.tudominio.com
ACME_EMAIL=tu-correo@tudominio.com
FRONTEND_URL=https://legal-ai.tudominio.com

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL=postgresql://legal_user:CAMBIAR_POR_SEGURO@localhost:5433/legal_ai
DB_PASSWORD=CAMBIAR_POR_SEGURO

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://:CAMBIAR_POR_SEGURO@localhost:6379
REDIS_PASSWORD=CAMBIAR_POR_SEGURO

# ============================================
# MINIO (Almacenamiento de documentos)
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CAMBIAR_POR_SEGURO
MINIO_BUCKET=legal-documents
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CAMBIAR_POR_SEGURO

# ============================================
# JWT
# ============================================
JWT_SECRET=CAMBIAR_POR_SEGURO
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=CAMBIAR_POR_SEGURO
JWT_REFRESH_EXPIRATION=7d

# ============================================
# AI - LLM compatible con OpenAI (Gemini por defecto)
# ============================================
# Gemini (Google AI Studio): https://aistudio.google.com/apikey
OPENAI_API_KEY=tu-clave-de-gemini-aqui
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# Alternativa OpenRouter (multi-modelo, una sola clave):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.5-flash

# AI - Embeddings: "local" (gratis con sentence-transformers) u "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# AI - Reranking (Cohere, opcional). Dejar vacio para desactivar.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ============================================
# CIFRADO DE TOKENS DE INTEGRACIONES (AES-256-GCM)
# Clave hex de 32 bytes (64 caracteres). Generar con:
#   openssl rand -hex 32
# ============================================
TOKEN_ENCRYPTION_KEY=tu-clave-hex-de-64-caracteres

# ============================================
# AI SERVICE (FastAPI interno)
# ============================================
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=CAMBIAR_POR_SEGURO

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=/api

# ============================================
# RATE LIMITING
# ============================================
DEFAULT_CREDITS_PER_USER=1000
DAILY_CREDIT_LIMIT=200
